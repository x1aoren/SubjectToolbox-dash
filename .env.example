# 学科工具箱 · 运营控制台 环境变量示例
#
# 用法：复制本文件为仓库根目录的 `.env`，按需取消注释/填写。
#   cp .env.example .env
# `.env` 已在 .gitignore 中，不会入库；里面可能有密码，权限建议 600。
#
# 加载规则（server/load-env.ts）：
# - 每次进程启动读取一次仓库根目录的 `.env`，改完需要重启服务；
# - 只读取存在且语法正确的文件，文件缺失不影响启动；
# - **系统环境变量优先**：systemd Environment= / EnvironmentFile=、Docker -e、
#   当前 shell 已设置的变量都会覆盖 `.env` 里的同名项；
# - 解析由 Node 内置 .env 解析完成，支持 # 注释、引号、export KEY=value。

# ── 运行模式 ────────────────────────────────────────────────────────────────
# 生产模式：不播种演示数据、不显示演示账号、禁止重建演示数据。
# 正式部署必须设置；不设则为开发/演示模式（首次启动会自动播种演示数据）。
# STB_ENV=production
# NODE_ENV=production

# ── 监听地址（生产建议只监听回环，由 Nginx/反代做 HTTPS）─────────────────────
HOST=127.0.0.1
PORT=8787

# ── 数据目录（默认 <仓库根>/data）───────────────────────────────────────────
# 生产建议独立目录并纳入备份；换目录等于换一个数据库。
# STB_DATA_DIR=/var/lib/subjecttoolbox

# ── 生产模式首次初始化（仅 users 表为空时使用，之后改这里不会改已有账号）─────
# STB_ADMIN_USER=admin
# STB_ADMIN_PASSWORD=换成强密码

# ── 工作区信息（生产模式提供时每次启动覆盖控制台里的设置）───────────────────
# STB_WORKSPACE_NAME=学科工具箱
# STB_ORG_NAME=市第二中学 · 信息技术组

# ── initial-admin.txt 中展示的登录地址（可选，不影响监听）────────────────────
# STB_PUBLIC_URL=https://stb.mcobs.cn

# ── 匿名上报 ────────────────────────────────────────────────────────────────
# 生产模式默认在首次初始化时关闭匿名上报；设为 1 时每次启动强制开启（覆盖控制台设置）。
# STB_ALLOW_ANONYMOUS=0

# ── 自定义 .env 路径（可选，默认 <仓库根>/.env；主要给测试/容器用）──────────
# STB_ENV_FILE=/etc/subjecttoolbox/console.env
